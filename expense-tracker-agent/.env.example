# Copy to .env and fill in. Never commit the real .env.
LLM=openai                      # openai | gemini (gemini not implemented yet)
OPENAI_API_KEY=
OPENAI_MODEL_INTENT=gpt-5-nano
OPENAI_MODEL_AGENT=gpt-5-mini
OPENAI_REASONING_EFFORT=low
# OPENAI_TEMPERATURE=           # optional; reasoning models may reject these
# OPENAI_TOP_P=
BACKEND_URL=http://localhost:8001/api/v1
HISTORY_DB=history.db
